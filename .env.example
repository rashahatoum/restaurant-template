# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical links, share images). Set on Vercel.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Laravel API (server only, never NEXT_PUBLIC). Empty → mock data and the
# browser draft, as before. Both values come privately from the backend developer.
API_BASE_URL=""
FRONTEND_API_KEY=""

# Dashboard login while API_BASE_URL is empty (with the API, Laravel's account is used).
DASHBOARD_USERNAME="change-me"
DASHBOARD_PASSWORD="change-me"

# Signs the dashboard login cookie. At least 32 random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
