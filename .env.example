# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical links, share images). Set on Vercel.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Dashboard login, until the Laravel API handles users.
DASHBOARD_USERNAME="change-me"
DASHBOARD_PASSWORD="change-me"

# Signs the dashboard login cookie. At least 32 random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
